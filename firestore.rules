rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isAdmin() {
      return hasRole('ADMIN');
    }
    
    function isFaculty() {
      return hasRole('FACULTY');
    }
    
    function isStudent() {
      return hasRole('STUDENT');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isFaculty());
      allow create, update: if isAdmin() || (isAuthenticated() && isOwner(userId));
      allow delete: if isAdmin();
    }
    
    // Students collection
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isFaculty() || 
        (isStudent() && request.auth.uid == studentId)
      );
      allow write: if isAdmin();
      allow update: if isAuthenticated() && request.auth.uid == studentId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role', 'departmentId', 'courseId']);
    }

    // Faculty collection
    match /faculty/{facultyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Academic structure: departments, courses, subjects, classes, timetables
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (isAdmin() || isFaculty() || (isStudent() && resource.data.studentId == request.auth.uid));
      allow write: if isAdmin();
    }

    match /timetables/{timetableId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Attendance Sessions: Faculty and Admin can create/update
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isFaculty();
      allow update: if isAdmin() || (isFaculty() && resource.data.facultyId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Attendance Records: Highly protected. Students can only read their own records.
    // Writes are authorized via server/Cloud Functions or authorized faculty/admin.
    match /attendanceRecords/{recordId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isFaculty() || 
        (isStudent() && resource.data.studentId == request.auth.uid)
      );
      // Faculty can create records during session or Admin can modify
      allow create: if isAdmin() || (isFaculty() && request.resource.data.facultyId == request.auth.uid);
      allow update: if isAdmin() || (isFaculty() && resource.data.facultyId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Dynamic QR Sessions
    match /qrSessions/{qrSessionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isFaculty();
    }

    // Biometric Face Profiles: Secure face embeddings
    match /faceProfiles/{studentId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == studentId);
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == studentId);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.targetRole == getUserData().role
      );
      allow create: if isAdmin() || isFaculty();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Audit logs: Read by admin, append-only by system/admin/faculty
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // System Settings
    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
